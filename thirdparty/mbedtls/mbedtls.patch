+                goto cleanup;
+            }
+            MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(r, xb, 32));
+            MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(r, r, &grp->N));
+        } while (mbedtls_mpi_cmp_int(r, 0) == 0);

+    mbedtls_mpi_init(&k); mbedtls_mpi_init(&e);
+    MBEDTLS_MPI_CHK(derive_mpi(grp, &e, buf, blen));
+    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&e, eb, 32));
+    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(d, db, 32));
+    do {

// vtest vflags: -enable-globals -no-skip-unused
// cx-home/v#32: a global struct whose every field defaults to zero is zeroed in
// `_vinit` with memset, not built as a stack temporary of the whole struct (at
// -O0 vgc_heap's ~2 MB temporary overflowed a 2 MB stack in `_vinit`).
// cx-home/cx-core-code#268: nor with memset — its static storage is already
// zero, and the memset made every page of it resident at start-up.
struct Big {
mut:
	a    int
	p    &u8 = unsafe { nil }
	arr  [65536]u64
	flag bool
}

struct WithDefault {
	n int = 5
}

__global big = Big{}
__global big2 Big
__global with_default = WithDefault{}
// cx-home/cx-core-code#268: a number global with a C constant initializer
// (and a pointer global with a nil cast) is initialised on its definition, not
// assigned in `_vinit`
__global cfg_floor = u64(32) * 1024
__global cfg_zero = usize(0)
__global cfg_neg = int(-1)
__global cfg_ptr = &u64(unsafe { nil })

// ... and so is a number const with such a value
const cfg_const = usize(64) * 1024

fn main() {
	println(big.a + big2.a + with_default.n + int(cfg_floor) + int(cfg_zero) + cfg_neg + int(cfg_ptr == unsafe { nil }) + int(cfg_const))
}
